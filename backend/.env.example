# ================= ANGEL ONE SMARTAPI =================
# Full setup steps: see SETUP_ANGEL_ONE.md in the project root.
# 1. The SmartAPI app key (created at smartapi.angelone.in)
ANGEL_API_KEY=your_smartapi_key_here
# 2. Your Angel One client ID (login ID, e.g. A123456)
ANGEL_CLIENT_CODE=your_client_id_here
# 3. Your 4-digit login PIN (MPIN)
ANGEL_PIN=your_pin_here
# 4. The base32 TOTP secret shown when you enable TOTP (the text key, not the QR code)
ANGEL_TOTP_SECRET=your_totp_secret_here

# Historical candles are available on Angel One's SmartAPI. Keep true unless
# historical requests fail; then candles are built from live ticks only.
HAS_HISTORICAL_SUBSCRIPTION=true

# ================= DATABASE (optional — PostgreSQL) =================
# Leave blank to use the built-in JSON file (works fine for one machine).
# To use PostgreSQL (durable, professional):
#   1. psql -U postgres -c "CREATE DATABASE algotrade;"
#   2. Fill in YOUR password below:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/algotrade
DATABASE_URL=

# ================= SERVER =================
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ================= ALERTS (optional) =================
# --- WhatsApp via Twilio (needs a Twilio account + one-time sandbox join) ---
# 1. twilio.com → Console → copy SID + Auth Token below
# 2. Console → Messaging → WhatsApp sandbox → from YOUR phone, WhatsApp the
#    shown join code to +1 415 523 8886   (without this step nothing arrives!)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+917760605782

# --- Telegram (FREE, recommended — 2-minute setup, see alerts/telegram.js) ---
# Telegram (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
